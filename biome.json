{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/.expo",
      "!**/_generated",
      "!**/*.svg",
      "!apps/web/src/data/changelog.generated.ts",
      "!design_handoff_ui_revamp"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noReactNativeRawText": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn"
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": { "skip": ["Txt"] }
            }
          }
        }
      }
    },
    {
      "includes": ["**/components/ui/chart.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "useTailwindSortedClasses": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "tailwind": {
    "stylesheet": "./apps/web/src/styles/globals.css",
    "mergeFunctions": ["clsx", "cn"],
    "variantFunctions": ["cva"]
  }
}
