# Convex deployment URL (from `npx convex dev` in packages/backend, or your prod
# deployment). Inlined into the client bundle at build time.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Production web app origin, used to build shareable links to events/lists.
# Falls back to https://suro.clotet.dev when unset.
EXPO_PUBLIC_SITE_URL=https://suro.clotet.dev

# PostHog product analytics (project 28027, EU). Use the same
# client token the web app uses (NEXT_PUBLIC_POSTHOG_KEY). Leave the key empty
# to disable analytics locally. Inlined into the client bundle at build time;
# native EAS builds get the key from an EAS environment variable, not here.
# Set EXPO_PUBLIC_POSTHOG_KEY in both EAS production and preview environments.
# The production-apk profile also uses production; dev inherits preview.
# Feedback submission requires this key. Changing it requires a new native build.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# GlitchTip error reporting. Set these in the EAS production environment.
# DSN: sensitive visibility (public in the compiled app); upload token: secret.
# Keep reporting disabled for local development and previews.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE is derived from the commit by the EAS hook / build:* scripts.
