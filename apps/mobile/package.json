{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=dev expo run:android",
    "ios": "node scripts/run-ios-simulator.mjs",
    "ios:rebuild": "rm -rf ios android .expo && node scripts/run-ios-simulator.mjs",
    "web": "expo start --web",
    "build:android:preview": "mkdir -p build && node scripts/build-with-release.mjs --platform android --profile preview --local --output build/suro-preview.apk",
    "build:android:dev": "mkdir -p build && node scripts/build-with-release.mjs --platform android --profile dev --local --output build/suro-dev.apk",
    "build:android:prod-apk": "mkdir -p build && node scripts/build-with-release.mjs --platform android --profile production-apk --local --output build/suro-prod.apk",
    "build:android:release": "mkdir -p build && node scripts/build-with-release.mjs --platform android --profile production --local --output build/suro-release.aab",
    "build:ios:release": "mkdir -p build && PATH=/usr/bin:$PATH node scripts/build-with-release.mjs --platform ios --profile production --local --output build/suro-release.ipa",
    "presubmit:android:release": "pnpm -w changelog:generate",
    "submit:android:release": "bundle exec fastlane android release",
    "submit:android:metadata": "bundle exec fastlane android metadata",
    "submit:android:promote": "bundle exec fastlane android promote",
    "release:android": "pnpm run build:android:release && pnpm run submit:android:release",
    "submit:ios:beta": "bundle exec fastlane ios beta",
    "presubmit:ios:metadata": "pnpm -w changelog:generate",
    "submit:ios:metadata": "EXPO_APPLE_TEAM_ID=2XUF926TS6 eas metadata:push --profile production",
    "submit:ios:release": "eas submit --platform ios --profile production --path build/suro-release.ipa --non-interactive",
    "submit:ios:review": "APP_VERSION=$(node -p \"require('../../package.json').version\") bundle exec fastlane ios submit_for_review",
    "release:ios": "pnpm run build:ios:release && pnpm run submit:ios:release && pnpm run submit:ios:metadata && pnpm run submit:ios:review",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eas-build-post-install": "node scripts/prepare-error-reporting.mjs"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@convex-dev/auth": "^0.0.96",
    "@expo-google-fonts/convergence": "^0.4.1",
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "~58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@floating-ui/dom": "^1.8.0",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@sentry/react-native": "^8.33.0",
    "backend": "workspace:*",
    "convex": "^1.48.0",
    "design-tokens": "workspace:*",
    "domain": "workspace:*",
    "error-reporting": "workspace:*",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.64.0",
    "posthog-react-native": "^4.84.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.26.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "use-intl": "^4.14.9",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eas-cli": "^27.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react",
        "react-dom"
      ]
    }
  }
}
