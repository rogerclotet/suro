# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# The web app talks only to Convex. Auth (Google/Resend), JWT keys, SITE_URL,
# and file storage all live on the Convex deployment's own env — set those with
# `npx convex env set` in packages/backend, not here.

# Convex (backend). The deployment URL from `npx convex dev` (packages/backend).
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# GlitchTip via the Sentry SDK. Leave environment empty for local/preview builds.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Derived automatically from the build commit, suro@<7-character SHA>.
# NEXT_PUBLIC_SENTRY_RELEASE is generated by next.config.ts; do not set manually.

# Build-time only. Store SENTRY_AUTH_TOKEN in CI secrets, never in public variables.
SENTRY_URL=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# CI/Docker supplies the deployed commit; local builds use git rev-parse HEAD.
SURO_COMMIT_SHA=""
