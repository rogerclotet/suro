<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The app talks to Convex over HTTPS and must stay
  cleartext-blocked in release; this exists so the on-device tests can point at a
  MockWebServer on loopback, which only speaks plain HTTP.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
